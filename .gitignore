# ============================================================
# blog-dev-vite — Vite + React + TypeScript (build estático)
# ============================================================

# ---------- dependências ----------
node_modules/
.pnp
.pnp.js
.pnp.cjs
.yarn/
.npm/
.pnpm-store/

# NÃO ignorar package-lock.json — ele deve ser commitado
# para builds reproduzíveis.
!package-lock.json

# ---------- build / saída ----------
dist/
dist-ssr/
build/
out/
.output/
.vite/
vite.config.*.timestamp-*.mjs

# Gerado em `npm run build` (scripts/generate-search-index.mjs).
# É artefato de build — não precisa versionar.
public/search-index.json

# ---------- TypeScript ----------
*.tsbuildinfo
tsconfig.tsbuildinfo

# ---------- ambiente / segredos (SEGURANÇA) ----------
# Nunca commitar arquivos com tokens, chaves ou senhas.
.env
.env.*
!.env.example
*.local
*.pem
*.key
*.p12
*.pfx
*.jks
*.keystore
secrets/
credentials/
id_rsa*
*.token

# ---------- logs ----------
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ---------- testes / cobertura / cache de linters ----------
coverage/
.nyc_output/
.eslintcache
.oxlintcache
.stylelintcache
*.test.snap

# ---------- deploy / hospedagem estática ----------
.vercel/
.netlify/
.surge/
.wrangler/
firebase-debug.log
firestore-debug.log

# ---------- SO ----------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini

